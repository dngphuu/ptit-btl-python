*.swo
*~

# =============================================================================
# OS-generated files
# =============================================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.fuse_hidden*
.directory
.Trash-*

# =============================================================================
# Game / runtime artifacts
# =============================================================================
# Pygame / OpenCV logs and crash dumps
*.log
crash_*.txt

# MediaPipe model cache (downloaded at runtime)
mediapipe_cache/

# Screenshots or recordings captured during gameplay
screenshots/
recordings/
*.mp4
*.avi
*.mkv

# Save data / user preferences generated at runtime
saves/
*.sav
*.dat

# =============================================================================
# Project-specific
# =============================================================================
# Mockup exports (keep sources, ignore rendered exports if any)
mockups/exports/

# Temporary / scratch files
*.tmp
*.bak
*.orig
